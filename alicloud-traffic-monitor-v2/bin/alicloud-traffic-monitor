#!/bin/sh
# ==============================================================================
# Alibaba Cloud ECS Outbound Traffic Monitor v2.0
# Alpine Linux + OpenRC + Telegram
# 
# Features:
# - Atomic state management (原子性状态管理)
# - Robust error handling (完善的错误处理)
# - Structured logging (结构化日志记录)
# - Network resilience (网络恢复能力)
# ==============================================================================

set -u

# ─────────────────────────────────────────────────────────────────────────
# 环境变量和常量
# ─────────────────────────────────────────────────────────────────────────

readonly APP_NAME="alicloud-traffic-monitor"
readonly APP_VERSION="2.0.0"

APP_DIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)" || APP_DIR="/opt/alicloud-traffic-monitor"
LIB_DIR="$APP_DIR/libs"
CONF="${CONF:-/etc/alicloud-traffic-monitor.conf}"
STATE_DIR="${STATE_DIR:-/var/lib/alicloud-traffic-monitor}"
LOG_FILE="$STATE_DIR/traffic.log"
LOCK_FILE="$STATE_DIR/limit.lock"

# ─────────────────────────────────────────────────────────────────────────
# 加载库文件
# ─────────────────────────────────────────────────────────────────────────

load_libraries() {
    local libs=(
        "state.sh"
        "logger.sh"
        "config.sh"
        "network.sh"
        "notify.sh"
        "service.sh"
    )
    
    for lib in "${libs[@]}"; do
        local lib_path="$LIB_DIR/$lib"
        
        if [ ! -f "$lib_path" ]; then
            echo "ERROR: library not found: $lib_path" >&2
            return 1
        fi
        
        # shellcheck source=/dev/null
        if ! . "$lib_path"; then
            echo "ERROR: failed to load library: $lib" >&2
            return 1
        fi
    done
    
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# 初始化系统
# ─────────────────────────────────────────────────────────────────────────

init_system() {
    # 初始化状态管理
    state_init "$STATE_DIR" || return 1
    
    # 初始化日志系统
    log_init "$LOG_FILE" || return 1
    
    # 加载配置文件
    if [ -f "$CONF" ]; then
        config_load "$CONF" || return 1
    else
        log_error "Configuration file not found: $CONF"
        return 1
    fi
    
    # 验证配置
    if ! config_validate; then
        log_error "Configuration validation failed"
        return 1
    fi
    
    # 检测初始化系统
    service_detect_init >/dev/null
    
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# 获取或初始化状态数据
# ─────────────────────────────────────────────────────────────────────────

get_or_init_state() {
    state_load || true
    
    # 设置默认值（如果不存在）
    CURRENT_MONTH="${CURRENT_MONTH:-$(date '+%Y-%m')}"
    MONTH_EGRESS="${MONTH_EGRESS:-0}"
    LAST_TX="${LAST_TX:-0}"
    REPORT_COUNT="${REPORT_COUNT:-0}"
    NEXT_REPORT="${NEXT_REPORT:-$REPORT_STEP}"
    LIMIT_REACHED="${LIMIT_REACHED:-0}"
    
    # 尝试初始化LAST_TX
    if [ "$LAST_TX" -eq 0 ]; then
        if LAST_TX="$(net_get_tx_bytes "$INTERFACE" 2>/dev/null)"; then
            :
        else
            log_warn "Failed to initialize LAST_TX"
            LAST_TX=0
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────
# 保存状态到文件
# ─────────────────────────────────────────────────────────────────────────

save_state() {
    state_write \
        "CURRENT_MONTH" "$CURRENT_MONTH" \
        "MONTH_EGRESS" "$MONTH_EGRESS" \
        "LAST_TX" "$LAST_TX" \
        "REPORT_COUNT" "$REPORT_COUNT" \
        "NEXT_REPORT" "$NEXT_REPORT" \
        "LIMIT_REACHED" "$LIMIT_REACHED" || {
        
        log_error "Failed to save state"
        return 1
    }
    
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# 新自然月处理
# ─────────────────────────────────────────────────────────────────────────

handle_new_month() {
    log_event "NEW_MONTH" "New billing cycle: $CURRENT_MONTH"
    
    MONTH_EGRESS=0
    REPORT_COUNT=0
    NEXT_REPORT="$REPORT_STEP"
    LIMIT_REACHED=0
    
    rm -f "$LOCK_FILE"
    
    # 重新初始化TX计数
    if LAST_TX="$(net_get_tx_bytes "$INTERFACE")"; then
        :
    else
        log_warn "Failed to initialize TX counter for new month"
        LAST_TX=0
    fi
    
    save_state || return 1
    
    # 启动服务
    if service_try_start "$SINGBOX_SERVICE"; then
        log_info "Service started: $SINGBOX_SERVICE"
    else
        log_warn "Failed to start service: $SINGBOX_SERVICE"
    fi
    
    # 发送通知
    notify_new_month "$CURRENT_MONTH" || true
}

# ─────────────────────────────────────────────────────────────────────────
# 发送阶梯报告
# ─────────────────────────────────────────────────────────────────────────

send_report() {
    REPORT_COUNT=$((REPORT_COUNT + 1))
    
    local used_gb remain remain_gb percent
    
    used_gb="$(net_format_bytes_to_gb "$MONTH_EGRESS")" || {
        log_error "Failed to format usage"
        return 1
    }
    
    remain="$(net_calculate_remaining "$MONTH_EGRESS" "$LIMIT")" || {
        log_error "Failed to calculate remaining"
        return 1
    }
    
    remain_gb="$(net_format_bytes_to_gb "$remain")" || {
        log_error "Failed to format remaining"
        remain_gb="unknown"
    }
    
    percent="$(net_calculate_percentage "$MONTH_EGRESS" "$LIMIT")" || {
        log_error "Failed to calculate percentage"
        percent="unknown"
    }
    
    log_info "Report #$REPORT_COUNT: used=${used_gb}GB, remaining=${remain_gb}GB, percent=${percent}%"
    
    notify_report "$REPORT_COUNT" "$used_gb" "$percent" "$remain_gb" "$CURRENT_MONTH" || {
        log_warn "Failed to send notification"
    }
    
    NEXT_REPORT=$((NEXT_REPORT + REPORT_STEP))
    save_state || return 1
}

# ─────────────────────────────────────────────────────────────────────────
# 达到限额处理
# ─────────────────────────────────────────────────────────────────────────

handle_limit_reached() {
    if [ "$LIMIT_REACHED" -eq 1 ]; then
        return 0
    fi
    
    LIMIT_REACHED=1
    touch "$LOCK_FILE"
    
    log_event "LIMIT_REACHED" "200GB limit reached"
    
    # 停止服务
    if service_try_stop "$SINGBOX_SERVICE"; then
        log_info "Service stopped: $SINGBOX_SERVICE"
    else
        log_warn "Failed to stop service: $SINGBOX_SERVICE"
    fi
    
    # 更新状态
    REPORT_COUNT=20
    NEXT_REPORT=$((LIMIT + REPORT_STEP))
    
    save_state || return 1
    
    # 发送通知
    local used_gb
    used_gb="$(net_format_bytes_to_gb "$MONTH_EGRESS")" || used_gb="unknown"
    
    notify_limit_reached "$used_gb" "$CURRENT_MONTH" || {
        log_warn "Failed to send limit notification"
    }
}

# ─────────────────────────────────────────────────────────────────────────
# 熔断防御 - 检查是否需要停止服务
# ─────────────────────────────────────────────────────────────────────────

circuit_breaker_check() {
    if [ "$LIMIT_REACHED" -eq 1 ] || [ -f "$LOCK_FILE" ]; then
        if service_is_running "$SINGBOX_SERVICE"; then
            log_warn "Circuit breaker: stopping $SINGBOX_SERVICE"
            if service_stop "$SINGBOX_SERVICE"; then
                log_info "Service force-stopped by circuit breaker"
            fi
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────
# 主监控循环
# ─────────────────────────────────────────────────────────────────────────

run_monitor() {
    mkdir -p "$STATE_DIR" || {
        log_error "Failed to create state directory"
        exit 1
    }
    
    get_or_init_state
    
    log_info "Monitor started: interface=$INTERFACE, interval=${INTERVAL}s"
    config_show | while IFS= read -r line; do
        log_debug "$line"
    done
    
    local error_count=0
    
    while true; do
        # 检查月份是否变化
        local real_month
        real_month="$(date '+%Y-%m')"
        
        if [ "$CURRENT_MONTH" != "$real_month" ]; then
            CURRENT_MONTH="$real_month"
            handle_new_month || {
                log_error "Failed to handle new month"
                error_count=$((error_count + 1))
            }
        fi
        
        # 读取当前TX值
        local current_tx
        if ! current_tx="$(net_get_tx_bytes "$INTERFACE")"; then
            log_warn "Failed to read TX bytes"
            error_count=$((error_count + 1))
            
            if [ "$error_count" -gt 10 ]; then
                log_error "Too many consecutive errors, stopping"
                exit 1
            fi
            
            sleep "$INTERVAL"
            continue
        fi
        
        error_count=0
        
        # 检测计数器重置
        if net_detect_reset "$current_tx" "$LAST_TX"; then
            log_warn "TX counter reset detected (device reboot/reset?)"
        fi
        
        # 计算差值
        local diff
        if ! diff="$(net_calculate_delta "$current_tx" "$LAST_TX")"; then
            log_warn "Failed to calculate delta"
            sleep "$INTERVAL"
            continue
        fi
        
        LAST_TX="$current_tx"
        
        # 累加月度流量
        if ! MONTH_EGRESS="$(net_safe_add "$MONTH_EGRESS" "$diff")"; then
            log_error "Integer overflow in traffic calculation"
            # 防止进一步恶化，重置为LIMIT
            MONTH_EGRESS="$LIMIT"
        fi
        
        # 检查是否需要发送报告
        while [ "$MONTH_EGRESS" -ge "$NEXT_REPORT" ] && [ "$NEXT_REPORT" -lt "$LIMIT" ]; do
            send_report || {
                log_error "Failed to send report"
            }
        done
        
        # 检查是否达到限额
        if [ "$MONTH_EGRESS" -ge "$LIMIT" ]; then
            handle_limit_reached || {
                log_error "Failed to handle limit"
            }
        fi
        
        # 熔断防御
        circuit_breaker_check
        
        # 保存状态
        save_state || {
            log_error "Failed to save state"
        }
        
        sleep "$INTERVAL"
    done
}

# ─────────────────────────────────────────────────────────────────────────
# 显示状态命令
# ─────────────────────────────────────────────────────────────────────────

cmd_status() {
    if ! init_system; then
        echo "ERROR: Failed to initialize system" >&2
        return 1
    fi
    
    get_or_init_state
    
    echo "=== $APP_NAME Status ==="
    echo ""
    echo "Version             : $APP_VERSION"
    echo "Status              : $(service_get_status "$SINGBOX_SERVICE")"
    echo ""
    echo "Billing Cycle       : $CURRENT_MONTH"
    echo "Egress Used         : $(net_format_bytes_to_gb "$MONTH_EGRESS")  GB / 200 GB"
    echo "Usage Rate          : $(net_calculate_percentage "$MONTH_EGRESS" "$LIMIT") %"
    echo "Remaining Quota     : $(net_format_bytes_to_gb "$(net_calculate_remaining "$MONTH_EGRESS" "$LIMIT")") GB"
    echo ""
    echo "Notification Count  : $REPORT_COUNT"
    echo "Circuit Breaker     : $([ "$LIMIT_REACHED" -eq 1 ] && echo "🚨 LOCKED" || echo "🟢 OK")"
    echo ""
    echo "Last Updated        : $(stat -c '%y' "$STATE_FILE" 2>/dev/null || echo 'unknown')"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────
# 测试命令
# ─────────────────────────────────────────────────────────────────────────

cmd_test() {
    if ! init_system; then
        echo "ERROR: Failed to initialize system" >&2
        return 1
    fi
    
    echo "Testing Telegram notification..."
    
    if notify_test; then
        echo "✅ Test completed successfully"
        return 0
    else
        echo "❌ Test failed"
        return 1
    fi
}

# ─────────────────────────────────────────────────────────────────────────
# 诊断命令
# ─────────────────────────────────────────────────────────────────────────

cmd_diagnose() {
    echo "=== System Diagnosis ==="
    echo ""
    
    echo "1. Network Interface Check:"
    if [ -d "/sys/class/net/$INTERFACE" ]; then
        echo "   ✅ Interface exists: $INTERFACE"
        
        if [ -f "/sys/class/net/$INTERFACE/statistics/tx_bytes" ]; then
            local tx
            tx="$(cat "/sys/class/net/$INTERFACE/statistics/tx_bytes")"
            echo "   ✅ TX bytes readable: $tx"
        else
            echo "   ❌ Cannot read TX bytes"
        fi
    else
        echo "   ❌ Interface not found: $INTERFACE"
    fi
    
    echo ""
    echo "2. Service Check:"
    echo "   Service: $SINGBOX_SERVICE"
    echo "   Status: $(service_get_status "$SINGBOX_SERVICE")"
    
    echo ""
    echo "3. Configuration Check:"
    if [ -f "$CONF" ]; then
        echo "   ✅ Configuration file found"
        echo "   Telegram: $([ -n "${TG_BOT_TOKEN:-}" ] && echo "configured" || echo "not configured")"
    else
        echo "   ❌ Configuration file not found: $CONF"
    fi
    
    echo ""
    echo "4. State Check:"
    if [ -f "$STATE_FILE" ]; then
        echo "   ✅ State file found"
        echo "   Current month: $CURRENT_MONTH"
        echo "   Egress: $(net_format_bytes_to_gb "$MONTH_EGRESS") GB"
    else
        echo "   ℹ️  State file not yet created"
    fi
    
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────
# 主程序入口
# ─────────────────────────────────────────────────────────────────────────

main() {
    # 加载库文件
    if ! load_libraries; then
        echo "ERROR: Failed to load libraries" >&2
        exit 1
    fi
    
    case "${1:-}" in
        run)
            init_system || exit 1
            run_monitor
            ;;
        status)
            cmd_status
            ;;
        test)
            cmd_test
            ;;
        diagnose)
            init_system || exit 1
            cmd_diagnose
            ;;
        version)
            echo "$APP_NAME v$APP_VERSION"
            ;;
        *)
            cat << EOF
Usage: $APP_NAME {run|status|test|diagnose|version}

Commands:
  run         Start the monitoring daemon
  status      Show current traffic status
  test        Send a test Telegram notification
  diagnose    Run system diagnostics
  version     Show version information

Examples:
  $APP_NAME run
  $APP_NAME status
  $APP_NAME test

EOF
            exit 1
            ;;
    esac
}

main "$@"
