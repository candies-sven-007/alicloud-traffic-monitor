#!/sbin/openrc-run
# ============================================================================
# OpenRC Service Definition for Alibaba Cloud Traffic Monitor
# ============================================================================

name="Alibaba Cloud Traffic Monitor"
description="Alibaba Cloud ECS public egress traffic monitor & sing-box circuit breaker"

command="/usr/local/sbin/alicloud-traffic-monitor"
command_args="run"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

# Restart behavior
respawn_delay=5
respawn_max=5

# ─────────────────────────────────────────────────────────────────────────
# Service Dependencies
# ─────────────────────────────────────────────────────────────────────────

depend() {
    need localmount net
    after firewall
    before sing-box
}

# ─────────────────────────────────────────────────────────────────────────
# Pre-start Checks
# ─────────────────────────────────────────────────────────────────────────

start_pre() {
    # Create state directory with proper permissions
    checkpath --directory --mode 0700 /var/lib/alicloud-traffic-monitor || {
        eerror "Failed to create state directory"
        return 1
    }
    
    # Verify configuration file exists and is readable
    if [ ! -f /etc/alicloud-traffic-monitor.conf ]; then
        eerror "Configuration file not found: /etc/alicloud-traffic-monitor.conf"
        eerror "Please run: alicloud-traffic-monitor --setup"
        return 1
    fi
    
    # Verify command exists and is executable
    if [ ! -x "$command" ]; then
        eerror "Command not executable: $command"
        return 1
    fi
    
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# Post-start Actions
# ─────────────────────────────────────────────────────────────────────────

start_post() {
    einfo "Traffic monitor started, check status with: rc-service $RC_SVCNAME status"
    einfo "View log: tail -f /var/lib/alicloud-traffic-monitor/traffic.log"
}

# ─────────────────────────────────────────────────────────────────────────
# Post-stop Actions  
# ─────────────────────────────────────────────────────────────────────────

stop_post() {
    einfo "Traffic monitor stopped"
}
