# ============================================================================
# Alibaba Cloud Traffic Monitor - Configuration File
# 阿里云流量监控 - 配置文件示例
# ============================================================================

# Network Interface to Monitor (监控的网卡名称)
# - Default: eth0
# - Common values: eth0, eth1, veth*, etc.
INTERFACE="eth0"

# Service Name to Control (受控服务名称)
# - Default: sing-box
# - This service will be stopped when traffic limit is reached
SINGBOX_SERVICE="sing-box"

# Check Interval in Seconds (检查间隔，秒)
# - Default: 1
# - Valid range: 1-60
# - Smaller values = more responsive but higher CPU usage
INTERVAL="1"

# Telegram Bot Token (Telegram 机器人 Token)
# - Get from @BotFather: https://t.me/BotFather
# - Format: 123456789:ABCDefGHIjklMNOpqrsTUVwxyz
# - Leave empty to disable Telegram notifications
TG_BOT_TOKEN=""

# Telegram Chat ID (Telegram 聊天 ID)
# - Get your ID from @userinfobot: https://t.me/userinfobot
# - Or use @IDBot: https://t.me/IDBot
# - Format: integer (can be negative for groups)
# - Leave empty to disable Telegram notifications
TG_CHAT_ID=""
